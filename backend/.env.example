# ============================================================
# Prayan Tutorials Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# Set these same variables on Render → Environment Variables.
# ============================================================

# ── SMTP (Gmail App Password) ────────────────────────────────
# Use a Gmail App Password, NOT your regular Gmail password.
# Generate at: https://myaccount.google.com/apppasswords
# IMPORTANT: Render free tier blocks outbound SMTP port 587.
# If SMTP is blocked, set SMTP_BLOCKED=true to skip the probe.
EMAIL_USER=prayan17062017@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_BLOCKED=false

# ── Admin / contact ──────────────────────────────────────────
ADMIN_EMAIL=prayan17062017@gmail.com

# ── Frontend URL (for CORS) ──────────────────────────────────
# Set this to your deployed frontend URL on Render.
FRONTEND_URL=https://your-frontend.onrender.com

# ── Google Maps Reviews API (optional) ──────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_PLACE_ID=ChIJy4_W7XKV5zsRZXCjtqMhSWc

# ── Database (optional override) ─────────────────────────────
# Default: SQLite at backend/prayan.db
# For production: use a PostgreSQL URL from Render.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
