# Gmail API OAuth2 credentials — obtain via get_gmail_token.py (run once locally).
# Set these in Render → Environment Variables. Never commit actual values.
GMAIL_CLIENT_ID=your_google_client_id
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REFRESH_TOKEN=your_google_refresh_token
