# Environment variables — never commit real credentials
.env
.env.local
.env.*.local
# .env.production is safe to commit (contains only the public backend URL, no secrets)
!.env.production
!.env.example

# Google OAuth credential files — NEVER commit these
client_secret.json
client_secret*.json
token.json
token*.json

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.db

# Node
node_modules/
dist/
.DS_Store
